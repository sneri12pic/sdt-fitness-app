AUTH_DOMAIN=auth.example.com
TLS_EMAIL=admin@example.com

POSTGRES_DB=sdt_fitness_auth
POSTGRES_USER=sdt_auth
POSTGRES_PASSWORD=replace-with-a-long-random-password

AUTH_JWT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
AUTH_REFRESH_TOKEN_PEPPER=replace-with-a-different-random-secret-of-at-least-32-characters

# Optional production tuning
AUTH_BCRYPT_COST=12
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_MILLIS=60000
